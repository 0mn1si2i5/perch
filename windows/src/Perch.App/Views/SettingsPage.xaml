<!-- macOS: SettingsView.swift -->
<UserControl x:Class="Perch.Windows.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Perch.Windows" >
<StackPanel>
 <TextBlock Text="随时唤出" Style="{StaticResource Section}" Margin="0,0,0,8"/>
 <TextBlock Text="Ctrl + Alt + P · 展开 / 收起 Perch"/><TextBlock Text="托盘图标可拖出隐藏区，放到任务栏常驻。" Style="{StaticResource Meta}" Margin="0,6"/>
 <Button Content="打开任务栏设置" Command="{Binding TaskbarSettings}" Style="{StaticResource StandardButton}" HorizontalAlignment="Left"/>
 <TextBlock Text="{DynamicResource settings.pet}" Style="{StaticResource Section}"/>
 <CheckBox Content="开启桌宠" IsChecked="{Binding PetEnabled}" Margin="0,0,0,8"/>
 <StackPanel Visibility="{Binding PetEnabled, Converter={StaticResource BoolVisibility}}"><ComboBox SelectedIndex="{Binding PetKind}"><ComboBoxItem Content="原生浮球"/><ComboBoxItem Content="Pox"/></ComboBox><TextBlock Text="{Binding PetHelp}" Style="{StaticResource Meta}" Margin="0,8"/>
 <Expander Header="桌宠选项" Visibility="{Binding IsPox, Converter={StaticResource BoolVisibility}}"><StackPanel Margin="0,8,0,0"><TextBlock Text="大小" Style="{StaticResource Meta}"/><Slider Minimum="135" Maximum="265" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding PetSize}" Margin="0,0,0,8"/><CheckBox Content="安静模式" IsChecked="{Binding Quiet}" Margin="0,0,0,8"/><CheckBox Content="媒体感知" IsChecked="{Binding MediaEnabled}" Margin="0,0,0,8"/><ComboBox SelectedIndex="{Binding Preview}"><ComboBoxItem Content="预览动作…"/><ComboBoxItem Content="休息"/><ComboBoxItem Content="招呼"/><ComboBoxItem Content="思考"/><ComboBoxItem Content="听音乐"/><ComboBoxItem Content="看视频"/><ComboBoxItem Content="庆祝"/><ComboBoxItem Content="困惑"/><ComboBoxItem Content="提起"/></ComboBox></StackPanel></Expander></StackPanel>
 <TextBlock Text="{DynamicResource settings.quota}" Style="{StaticResource Section}"/><CheckBox Content="每 5 分钟自动同步" IsChecked="{Binding AutoQuota}" Margin="0,0,0,8"/><Button Content="立即同步全部账号" Command="{Binding RefreshAllCommand}" Style="{StaticResource StandardButton}" HorizontalAlignment="Left"/>
 <TextBlock Text="{DynamicResource settings.handoff}" Style="{StaticResource Section}"/><Button Content="打开交接文件夹" Command="{Binding RevealHandoffs}" Style="{StaticResource StandardButton}" HorizontalAlignment="Left" Margin="0,0,0,8"/><local:HandoffHistory/>
 <Button Content="退出 Perch" Command="{Binding Quit}" Style="{StaticResource StandardButton}" HorizontalAlignment="Right" Margin="0,16,0,0"/>
 </StackPanel>
</UserControl>
