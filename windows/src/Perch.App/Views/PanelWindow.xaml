<!-- macOS: PerchPanel.swift -->
<Window x:Class="Perch.Windows.Panel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Perch.Windows" Title="Perch" Width="340" Height="570" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Topmost="True" Background="Transparent" Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" FontSize="{DynamicResource FontBody}" TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
 <AdornerDecorator><Grid x:Name="Surface" SizeChanged="SurfaceSized">
 <Border x:Name="Backdrop" Background="{DynamicResource PanelFill}" CornerRadius="20" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1"/>
 <Grid Margin="16" KeyboardNavigation.TabNavigation="Cycle"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
  <Image Source="{Binding ProductIcon}" Width="30" Height="30" Margin="0,0,9,0" Visibility="{Binding IsAccounts, Converter={StaticResource BoolVisibility}}"/>
  <TextBlock Text="{Binding Title}" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="FontSize" Value="{DynamicResource FontTitle}"/><Setter Property="FontWeight" Value="SemiBold"/><Style.Triggers><DataTrigger Binding="{Binding IsAccounts}" Value="True"><Setter Property="FontSize" Value="20"/><Setter Property="FontWeight" Value="Bold"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
 </StackPanel>
 <Grid Grid.Row="1">
 <ScrollViewer x:Name="accountsView" Visibility="{Binding IsAccounts, Converter={StaticResource BoolVisibility}}"><local:AccountsPage/></ScrollViewer>
 <ScrollViewer x:Name="settingsView" Visibility="{Binding IsSettings, Converter={StaticResource BoolVisibility}}"><local:SettingsPage/></ScrollViewer>
 <ScrollViewer x:Name="infoView" Visibility="{Binding IsInfo, Converter={StaticResource BoolVisibility}}"><local:InfoPage/></ScrollViewer>
 <ScrollViewer x:Name="addView" Visibility="{Binding IsAdd, Converter={StaticResource BoolVisibility}}"><local:NewAccountPage/></ScrollViewer>
 </Grid>
 <DockPanel Grid.Row="2" Margin="0,6,0,0" Visibility="{Binding HasMessage, Converter={StaticResource BoolVisibility}}"><Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" local:Icon.Kind="close" Command="{Binding ClearMessage}" ToolTip="关闭提示"/><TextBlock Text="{Binding Message}" Foreground="{DynamicResource Amber}" FontSize="{DynamicResource FontMeta}" MaxHeight="34" TextTrimming="CharacterEllipsis"/></DockPanel>
 <StackPanel Grid.Row="3"><Separator Margin="0,8"/><DockPanel KeyboardNavigation.TabIndex="100">
 <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Command="{Binding Home}" local:Icon.Kind="house" ToolTip="主页" AutomationProperties.Name="主页" Margin="8,0,0,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource IconButton}"><Style.Triggers><DataTrigger Binding="{Binding IsAccounts}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Accent}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Command="{Binding Info}" local:Icon.Kind="info" ToolTip="信息" Margin="8,0,0,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource IconButton}"><Style.Triggers><DataTrigger Binding="{Binding IsInfo}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Accent}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Command="{Binding Settings}" local:Icon.Kind="settings" ToolTip="设置" Margin="8,0,0,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource IconButton}"><Style.Triggers><DataTrigger Binding="{Binding IsSettings}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Accent}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Command="{Binding TogglePet}" local:Icon.Kind="pet" ToolTip="桌宠" Margin="8,0,0,0" Visibility="{Binding PetEnabled, Converter={StaticResource BoolVisibility}}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource IconButton}"><Style.Triggers><DataTrigger Binding="{Binding PetVisible}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Accent}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></StackPanel><Button Content="＋ 新建账号" Command="{Binding Add}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SubtleButton}"><Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/><Style.Triggers><DataTrigger Binding="{Binding IsAdd}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Accent}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></DockPanel></StackPanel>
 </Grid></Grid></AdornerDecorator>
</Window>